DATABASE_URL=postgresql://postgres:postgres@localhost:5432/technostrelka
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://localhost:8000
# См. docker-compose.mobile.yml — база для ссылок на /static/ с телефона (тот же хост:порт, что в приложении)
# MOBILE_PUBLIC_BASE_URL=http://192.168.1.50:8888
# CORS_ORIGINS=*
# Ассистент: тот же прокси, что SmartWallet (GigaChat). Переопределите при необходимости.
GIGACHAT_PROXY_URL=https://derendyaev.ru/api/gigachat/message
GIGACHAT_MODEL=GigaChat:latest
GIGACHAT_MAX_TOKENS=256
GIGACHAT_TIMEOUT=30
# OpenAI (в коде ассистента не используется; оставлено для совместимости)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
# Optional: X-Admin-Key header for POST /events and POST /home-categories
ADMIN_API_KEY=

# Импорт: RSS + visitudmurtia.org + izh.afishagoroda.ru + adm.izh.ru
INGEST_ENABLED=false
INGEST_INTERVAL_MINUTES=360
# INGEST_HTTP_TIMEOUT=45
# INGEST_TIMEZONE=Europe/Samara
# INGEST_STRICT_EVENT_QUALITY=true
# INGEST_MIN_DESCRIPTION_LEN=40
# INGEST_MIN_IMAGES_PER_EVENT=1
# DEFAULT_EVENT_PLACE=г. Ижевск, Удмуртская Респ., Россия
# IZHEVSK_RSS_FEED_URLS=https://example.com/feed.xml,https://...
RSS_REQUIRE_REGION_KEYWORD=true

# Календарь adm.izh.ru (ingest_key adm_izh:<id>)
# ADM_IZH_FETCH_DETAILS=true
# ADM_IZH_MAX_DETAIL_FETCHES=200
# ADM_IZH_MAX_EVENTS=2500
# ADM_IZH_MAX_IMAGES_PER_EVENT=30
# ADM_IZH_DETAIL_DELAY_SEC=0.1
# ADM_IZH_VERIFY_SSL=true

# Visit Udmurtia (ingest_key visit_udm:<slug>)
# VISIT_UDM_ENABLED=true
# VISIT_UDM_MAX_DETAIL_FETCHES=80
# VISIT_UDM_VERIFY_SSL=true

# Афиша Города (ingest_key afisha_goroda:<slug>)
# AFISHA_GORODA_ENABLED=true
# AFISHA_GORODA_VERIFY_SSL=false

# Яндекс.Афиша (ingest_key yandex_afisha:<city>:<rubric>:<slug>)
# YANDEX_AFISHA_ENABLED=true
# YANDEX_AFISHA_CITY_SLUG=izhevsk
# YANDEX_AFISHA_VERIFY_SSL=false

# После импорта удалять неполные события (имя, slug, фото, описание, дата, место, url, тип, галерея)
# INGEST_PURGE_INCOMPLETE_AFTER_RUN=true
# EVENT_COMPLETENESS_ENABLED=true
# EVENT_COMPLETENESS_REQUIRE_EXTRAS=false
